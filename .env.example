# =============================================================================
# Croply AI Service - Environment Variables Configuration
# =============================================================================

# Configuración del Servidor FastAPI
PORT=9000
ENVIRONMENT=development

# =============================================================================
# Configuración del Proveedor LLM (Generación Agronómica Empática)
# Valores válidos para LLM_PROVIDER: "ollama" | "gemini"
# =============================================================================
LLM_PROVIDER=ollama

# Configuración del Microservicio Ollama (cuando LLM_PROVIDER=ollama)
# En entorno Docker Compose utilizar: http://croply-ollama:11434
# En ejecución local en la máquina host utilizar: http://localhost:11434
OLLAMA_BASE_URL=http://croply-ollama:11434
OLLAMA_URL=http://croply-ollama:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=90.0

# Configuración de Google Gemini API (cuando LLM_PROVIDER=gemini)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0
